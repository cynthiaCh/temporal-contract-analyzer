# Trusted grader only. Never use this image for the model/solver workspace.
# Build the context emitted by prepare_grader_build.py, not either repository.
# Verify this local tag against the expected immutable solver ID before building.
ARG PUBLIC_RUNTIME=tempoevo-solver:public-rebuild-01
FROM ${PUBLIC_RUNTIME}
WORKDIR /opt/swe-tempoc
ADD benchmark-source.tar /opt/swe-tempoc/
COPY grader-inputs.json /opt/grader-build/inputs.json
COPY install_grader_runtime.py /opt/grader-build/install_grader_runtime.py
RUN python3 -B /opt/grader-build/install_grader_runtime.py \
 && python3 -B swe_tempoc.py doctor > /opt/grader-build/doctor.json
ENV PATH="/opt/swe-tempoc/.swe-tempoc/toolchains/node-v16.20.2/bin:/opt/go1.13.8/bin:/usr/local/bin:/usr/bin:/bin"
ENTRYPOINT ["python3", "-B", "/opt/swe-tempoc/swe_tempoc.py"]
CMD ["doctor"]
