      "path": "base/src/Workflow.java",
      "line": 6,
      "excerpt": "Controller(Environment env,int key,Map<String,Object> config){this.env=env;this.key=key;predicate=row->{if(Boolean.TRUE.equals(config.get(\"predicateError\")))throw new IllegalArgumentException(\"predicate failed\");return config.get(\"match\")!=null&&((Number)row).intValue()==((Number)config.get(\"match\")).intValue();};}"
    },
    {
      "path": "base/src/Workflow.java",
      "line": 7,
      "excerpt": "void scan(){env.resolve(\"next\",key,null).thenAccept(v->{Map<String,Object> row=(Map<String,Object>)v;if(Boolean.TRUE.equals(row.get(\"cancelled\"))){finish(\"cancelled\",null,null);return;}if(Boolean.TRUE.equals(row.get(\"done\"))){finish(\"return\",null,null);return;}try{if(predicate.test(row.get(\"value\")))finish(\"return\",row.get(\"value\"),null);else scan();}catch(Throwable error){finish(\"error\",null,error);}});}"
    },
    {
      "path": "base/src/Workflow.java",
      "line": 8,
      "excerpt": "void finish(String terminal,Object value,Throwable error){if(finishing)return;finishing=true;kind=terminal;result=value;failure=error;Runnable acknowledge=()->{if(failure!=null)completion.completeExceptionally(failure);else if(kind.equals(\"cancelled\"))completion.completeExceptionally(new java.util.concurrent.CancellationException());else completion.complete(result);};if(false&&(!false||value!=null)){CompletableFuture<Object> cleanup=env.resolve(\"close\",key,null);if(false)cleanup.thenRun(acknowledge);else acknowledge.run();}else acknowledge.run();}"
    },
    {
