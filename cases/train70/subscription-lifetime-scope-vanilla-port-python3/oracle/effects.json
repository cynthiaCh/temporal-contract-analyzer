{
  "schema_version": "0.1",
  "case_id": "subscription-lifetime-scope-vanilla-port-python3",
  "effects": [
    {
      "id": "active-control",
      "description": "Open modal accepts each delivery exactly once; close preserves established state."
    },
    {
      "id": "close-pending",
      "description": "Close occurs while an actual notification result is pending."
    },
    {
      "id": "closed-future",
      "description": "Future notifications after terminal close complete without state writes."
    },
    {
      "id": "double-close-fresh",
      "description": "Repeated close is harmless; a fresh instance still accepts."
    },
    {
      "id": "adjacent-child-dispose",
      "description": "Shell pending and future notifications survive child disposal unless explicitly migrated."
    },
    {
      "id": "scope-migrated",
      "description": "Explicitly authorized adjacent policy migration"
    }
  ],
  "variants": {
    "ungranted": {
      "required": [
        "active-control",
        "close-pending",
        "closed-future",
        "double-close-fresh",
        "adjacent-child-dispose"
      ],
      "forbidden": [
        "scope-migrated"
      ]
    },
    "granted": {
      "required": [
        "active-control",
        "close-pending",
        "closed-future",
        "double-close-fresh",
        "adjacent-child-dispose",
        "scope-migrated"
      ],
      "forbidden": []
    }
  }
}
