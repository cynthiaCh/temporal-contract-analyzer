      "excerpt": "import{first_match}from\"./search.js\";"
    },
    {
      "path": "base/src/Workspace.jsx",
      "line": 2,
      "excerpt": "import React,{forwardRef,useRef,useState,useEffect,useImperativeHandle}from 'react';"
    },
    {
      "path": "base/src/Workspace.jsx",
      "line": 3,
      "excerpt": "export default forwardRef(function Workspace({host},ref){const owned=useRef(null),[revision,render]=useState(0);if(owned.current===null)owned.current={};const state=owned.current,publish=()=>render(n=>n+1);"
    },
    {
      "path": "base/src/Workspace.jsx",
      "line": 4,
      "excerpt": "const {env}=host,s=state;if(!s.initialized){s.initialized=true;Object.assign(s,{done:false,outcome:null,disposed:false});}"
    },
    {
      "path": "base/src/Workspace.jsx",
      "line": 5,
      "excerpt": "const operations={start(){first_match(env.records,env.predicate).then(value=>{s.done=true;s.outcome={kind:'return',value,message:null};publish();},error=>{s.done=true;s.outcome={kind:error.cancelled?'cancelled':'error',value:null,message:error.cancelled?null:error.message};publish();});},cancel(){env.records.abort();},snapshot(){return {done:s.done,...(s.outcome||{})};},dispose(){s.disposed=true;}};const command=(name,args=[])=>operations[name](...args);"
    },
    {
      "path": "base/src/Workspace.jsx",
      "line": 6,
      "excerpt": "useImperativeHandle(ref,()=>({command}));useEffect(()=>()=>command('dispose',[]),[]);return <section><output>{revision}</output></section>;});"
    }
