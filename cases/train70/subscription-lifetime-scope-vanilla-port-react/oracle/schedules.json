{
  "schema_version": "0.1",
  "case_id": "subscription-lifetime-scope-vanilla-port-react",
  "schedules": [
    {
      "id": "active-control",
      "description": "Open modal accepts each delivery exactly once; close preserves established state.",
      "events": [
        "entry",
        "active-control",
        "manual resolve or clock advance",
        "observe"
      ]
    },
    {
      "id": "close-pending",
      "description": "Close occurs while an actual notification result is pending.",
      "events": [
        "entry",
        "close-pending",
        "manual resolve or clock advance",
        "observe"
      ]
    },
    {
      "id": "closed-future",
      "description": "Future notifications after terminal close complete without state writes.",
      "events": [
        "entry",
        "closed-future",
        "manual resolve or clock advance",
        "observe"
      ]
    },
    {
      "id": "double-close-fresh",
      "description": "Repeated close is harmless; a fresh instance still accepts.",
      "events": [
        "entry",
        "double-close-fresh",
        "manual resolve or clock advance",
        "observe"
      ]
    },
    {
      "id": "adjacent-child-dispose",
      "description": "Shell pending and future notifications survive child disposal unless explicitly migrated.",
      "events": [
        "entry",
        "adjacent-child-dispose",
        "manual resolve or clock advance",
        "observe"
      ]
    }
  ],
  "counterfactual_pairs": [
    {
      "left": "active-control",
      "right": "close-pending",
      "changed_relation": "Close occurs while an actual notification result is pending.",
      "expected_changed_effects": [
        "close-pending"
      ]
    },
    {
      "left": "active-control",
      "right": "closed-future",
      "changed_relation": "Future notifications after terminal close complete without state writes.",
      "expected_changed_effects": [
        "closed-future"
      ]
    },
    {
      "left": "active-control",
      "right": "double-close-fresh",
      "changed_relation": "Repeated close is harmless; a fresh instance still accepts.",
      "expected_changed_effects": [
        "double-close-fresh"
      ]
    },
    {
      "left": "active-control",
      "right": "adjacent-child-dispose",
      "changed_relation": "Shell pending and future notifications survive child disposal unless explicitly migrated.",
      "expected_changed_effects": [
        "adjacent-child-dispose"
      ]
    }
  ]
}
