      "path": "base/README.md",
      "line": 1,
      "excerpt": "Hotel coordination — A retained asynchronous record producer and a caller that selects the first match. Producer cleanup can suspend; the producer is retained independently of the consumer. Predicate may fail and a read may be cancelled."
    },
    {
      "path": "base/docs/host-api.md",
      "line": 1,
      "excerpt": "first_match owns a supplied retained asynchronous record source and a supplied predicate. The source has next/aclose asynchronous operations; cancellation interrupts a suspended read, and cleanup may suspend. Framework ports use actual JS async generators; Python uses actual async for/Task.cancel. Native cursor ports use actual Java CompletionStage, PHP Closure, Ruby blocks or Go typed completion callbacks plus a native completion channel, with native predicate failures. These cursor interfaces are declared adaptations of the original resource carrier, not built-in async-generator claims."
    },
    {
      "path": "base/src/workflow.php",
      "line": 1,
      "excerpt": "<?php"
    },
    {
      "path": "base/src/workflow.php",
      "line": 2,
      "excerpt": "class Controller {"
    },
    {
      "path": "base/src/workflow.php",
      "line": 3,
      "excerpt": "private $env,$key,$predicate,$done=false,$finishing=false,$kind,$value,$failure;"
    },
    {
      "path": "base/src/workflow.php",
      "line": 4,
      "excerpt": "function __construct($env,$key,$config){$this->env=$env;$this->key=$key;$this->predicate=function($row)use($config){if($config['predicateError'])throw new RuntimeException('predicate failed');return $config['match']!==null&&$row==$config['match'];};}"
    },
    {
      "path": "base/src/workflow.php",
      "line": 5,
      "excerpt": "function scan(){$this->env->resolve('next',$this->key,null,function($row){if(isset($row['cancelled'])&&$row['cancelled']){$this->finish('cancelled',null,null);return;}if($row['done']){$this->finish('return',null,null);return;}try{if(($this->predicate)($row['value']))$this->finish('return',$row['value'],null);else $this->scan();}catch(Throwable $error){$this->finish('error',null,$error);}});}"
    },
    {
      "path": "base/src/workflow.php",
      "line": 6,
      "excerpt": "function finish($kind,$value,$error){if($this->finishing)return;$this->finishing=true;$this->kind=$kind;$this->value=$value;$this->failure=$error;$ack=function($v=null){$this->done=true;};if(false&&(!false||$value!==null)){$this->env->resolve('close',$this->key,null,false?$ack:function($v){});if(!false)$ack();}else $ack();}"
    },
    {
      "path": "base/src/workflow.php",
      "line": 7,
      "excerpt": "function start(){$this->scan();}function cancel(){$this->env->output('cancelInput',$this->key,null);}function snapshot(){$s=['done'=>$this->done];if($this->done){$s['kind']=$this->kind;$s['value']=$this->value;$s['message']=$this->failure?$this->failure->getMessage():null;}return $s;}function dispose(){}"
    },
    {
