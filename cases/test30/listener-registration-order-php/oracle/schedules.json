{
  "schema_version": "0.1",
  "case_id": "listener-registration-order-php",
  "schedules": [
    {
      "id": "synchronous-bootstrap",
      "description": "Connect dispatches inline; bootstrap publish precedes select return, then ordinary update once.",
      "events": [
        "controlled-entry",
        "synchronous-bootstrap",
        "manual-completion",
        "close-and-observe-no-effects"
      ]
    },
    {
      "id": "deferred-bootstrap",
      "description": "Queued bootstrap follows connect return; bootstrap and update observed once.",
      "events": [
        "controlled-entry",
        "deferred-bootstrap",
        "manual-completion",
        "close-and-observe-no-effects"
      ]
    },
    {
      "id": "nested-switch",
      "description": "Bootstrap publisher selects B before outer connection returns; B remains live and cleanable.",
      "events": [
        "controlled-entry",
        "nested-switch",
        "manual-completion",
        "close-and-observe-no-effects"
      ]
    },
    {
      "id": "nested-close",
      "description": "Bootstrap publisher hides before connection returns; actual listener detached immediately and future update not accepted.",
      "events": [
        "controlled-entry",
        "nested-close",
        "manual-completion",
        "close-and-observe-no-effects"
      ]
    },
    {
      "id": "decode-after-switch",
      "description": "Accepted A update completes after B becomes current; old publication rejected.",
      "events": [
        "controlled-entry",
        "decode-after-switch",
        "manual-completion",
        "close-and-observe-no-effects"
      ]
    },
    {
      "id": "decode-after-close",
      "description": "Accepted update resolves after hide; no publication.",
      "events": [
        "controlled-entry",
        "decode-after-close",
        "manual-completion",
        "close-and-observe-no-effects"
      ]
    },
    {
      "id": "same-channel-reopen",
      "description": "Old update completes after identical transport reopened; fresh update remains live.",
      "events": [
        "controlled-entry",
        "same-channel-reopen",
        "manual-completion",
        "close-and-observe-no-effects"
      ]
    },
    {
      "id": "active-decode",
      "description": "Active delayed update waits and then publishes once.",
      "events": [
        "controlled-entry",
        "active-decode",
        "manual-completion",
        "close-and-observe-no-effects"
      ]
    },
    {
      "id": "decode-bootstrap-retire",
      "description": "Pending initial decode completes after hide; no stale bootstrap.",
      "events": [
        "controlled-entry",
        "decode-bootstrap-retire",
        "manual-completion",
        "close-and-observe-no-effects"
      ]
    },
    {
      "id": "nested-reopen",
      "description": "Bootstrap publisher hides/reopens identical channel; no old listener duplicate reception.",
      "events": [
        "controlled-entry",
        "nested-reopen",
        "manual-completion",
        "close-and-observe-no-effects"
      ]
    },
    {
      "id": "hide-before-deferred",
      "description": "Retire before queued connection bootstrap executes; no new decoding.",
      "events": [
        "controlled-entry",
        "hide-before-deferred",
        "manual-completion",
        "close-and-observe-no-effects"
      ]
    },
    {
      "id": "repeated-close",
      "description": "Close repeatedly without selection; empty and idempotent.",
      "events": [
        "controlled-entry",
        "repeated-close",
        "manual-completion",
        "close-and-observe-no-effects"
      ]
    },
    {
      "id": "reverse-active-completion",
      "description": "Two active accepted updates resolve in reverse order; both publish once, no invented freshness ordering.",
      "events": [
        "controlled-entry",
        "reverse-active-completion",
        "manual-completion",
        "close-and-observe-no-effects"
      ]
    },
    {
      "id": "independent-workspaces",
      "description": "Retiring one owner leaves a different owner live.",
      "events": [
        "controlled-entry",
        "independent-workspaces",
        "manual-completion",
        "close-and-observe-no-effects"
      ]
    },
    {
      "id": "shared-channel-workspaces",
      "description": "Two workspaces share one transport; retiring one leaves peer reception active.",
      "events": [
        "controlled-entry",
        "shared-channel-workspaces",
        "manual-completion",
        "close-and-observe-no-effects"
      ]
    },
    {
      "id": "equal-token-distinct-channels",
      "description": "Distinct transports with equal tokens do not share listener ownership.",
      "events": [
        "controlled-entry",
        "equal-token-distinct-channels",
        "manual-completion",
        "close-and-observe-no-effects"
      ]
    },
    {
      "id": "dispose-inflight",
      "description": "Actual framework unmount/native disposal ends visible output of retained decode.",
      "events": [
        "controlled-entry",
        "dispose-inflight",
        "manual-completion",
        "close-and-observe-no-effects"
      ]
    },
    {
      "id": "metrics-scope",
      "description": "Independent metrics remains delta-only or separately authorized bootstrap+delta.",
      "events": [
        "controlled-entry",
        "metrics-scope",
        "manual-completion",
        "close-and-observe-no-effects"
      ]
    }
  ],
