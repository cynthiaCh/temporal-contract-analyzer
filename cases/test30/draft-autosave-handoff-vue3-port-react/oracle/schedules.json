{
  "schema_version": "0.1",
  "case_id": "draft-autosave-handoff-vue3-port-react",
  "schedules": [
    {
      "id": "quiet-burst",
      "description": "A burst at 0/30/80 ms saves only latest text at 200 ms after maintenance; immediate baseline saves every edit.",
      "events": [
        "open-a",
        "edit-alpha-0",
        "edit-beta-30",
        "edit-gamma-80",
        "before-deadline-199",
        "deadline-200"
      ]
    },
    {
      "id": "second-burst",
      "description": "A later burst receives its own complete quiet interval and saves after the first batch retired.",
      "events": [
        "open-a",
        "edit-one-0",
        "save-one-120",
        "edit-two-120",
        "edit-three-150",
        "save-three-270"
      ]
    },
    {
      "id": "close-before-deadline",
      "description": "Close at 20 ms commits document-owned text before return after retiring its badge; no stale timer repeats it.",
      "events": [
        "open-a",
        "edit-a",
        "close-20",
        "read-after-return",
        "advance-past-old-deadline"
      ]
    },
    {
      "id": "switch-before-deadline",
      "description": "Switch before the first deadline saves A before return and never retargets its pending text into B.",
      "events": [
        "open-a",
        "edit-a",
        "open-b-20",
        "read-a-and-b",
        "edit-b",
        "deadline-b-140"
      ]
    },
    {
      "id": "same-document-reopen",
      "description": "Close and reopen the same document before the deadline restore latest text without retaining an old batch.",
      "events": [
        "open-a",
        "edit-first-visit",
        "close-20",
        "reopen-a",
        "read-restored-text",
        "edit-second-visit",
        "deadline-140",
        "close-twice"
      ]
    },
    {
      "id": "reentrant-switch-on-flush",
      "description": "A pending flush notifies inline and opens C inside outer open B; the newer navigation survives outer return. The immediate baseline already notified before the callback was armed.",
      "events": [
        "open-a",
        "edit-a",
        "arm-on-saved-open-c",
        "outer-open-b",
        "flush-notification-if-pending",
        "nested-open-c-if-notified",
        "outer-return",
        "edit-selected-document"
      ]
    },
    {
      "id": "reentrant-close-on-flush",
      "description": "A pending flush notifies inline and closes inside outer open B; outer navigation must not reopen it. The immediate baseline has no pending notification.",
      "events": [
        "open-a",
        "edit-a",
        "arm-on-saved-close",
        "outer-open-b",
        "flush-notification-if-pending",
        "nested-close-if-notified",
        "outer-return",
        "edit-if-active"
      ]
    },
    {
      "id": "reentrant-timer-save",
      "description": "A timer-fired save opens B through inline notification; the detached A badge is skipped and B subsequently saves with an active badge.",
      "events": [
        "open-a",
        "arm-on-saved-open-b",
        "edit-a",
        "save-a-and-nested-open-b",
        "edit-b",
        "save-b"
      ]
    },
    {
      "id": "reentrant-edit",
      "description": "An inline notification edits the still-active document again; the new burst survives retirement of the first batch.",
      "events": [
        "open-a",
        "arm-on-saved-edit-two",
        "edit-one",
        "save-one-and-edit-two",
        "before-second-deadline",
        "save-two"
      ]
    },
    {
      "id": "preview-delay",
      "description": "Preview emits exactly once at either its original 40 ms quiet interval or the separately authorized 120 ms interval.",
      "events": [
        "query-0",
        "check-39",
        "check-40",
        "check-119",
        "check-120"
      ]
    },
    {
      "id": "preview-hide",
      "description": "Hiding a preview discards pending query work and never flushes it in either authorization arm.",
      "events": [
        "query-0",
        "hide-10",
        "check-hide-return",
        "advance-600"
      ]
    },
    {
      "id": "preview-reuse",
      "description": "A hidden then reused preview publishes only its new query with the same quiet interval as an uninterrupted preview.",
      "events": [
        "query-old-0",
        "hide-10",
        "query-new-20",
        "check-59",
        "check-60",
        "check-139",
        "check-140"
      ]
    },
    {
      "id": "closed-empty",
      "description": "Deterministic lifecycle/input boundary closed-empty",
      "events": [
        "entry",
        "close-or-dispose",
        "synchronous-return",
        "quiescence"
      ]
    },
    {
      "id": "empty-text",
      "description": "Deterministic lifecycle/input boundary empty-text",
      "events": [
        "entry",
        "close-or-dispose",
        "synchronous-return",
        "quiescence"
      ]
    },
    {
      "id": "dispose-before-deadline",
      "description": "Deterministic lifecycle/input boundary dispose-before-deadline",
      "events": [
        "entry",
        "close-or-dispose",
        "synchronous-return",
        "quiescence"
      ]
    }
  ],
  "counterfactual_pairs": [
    {
      "left": "quiet-burst",
      "right": "second-burst",
      "changed_relation": "A second burst begins after the first deadline instead of extending the existing batch.",
      "expected_changed_effects": [
        "second-burst"
      ]
    },
    {
      "left": "quiet-burst",
      "right": "close-before-deadline",
      "changed_relation": "Close moves before the quiet deadline, requiring a detached-view flush instead of an active timer commit.",
      "expected_changed_effects": [
        "close-before-deadline"
      ]
    },
    {
      "left": "close-before-deadline",
      "right": "switch-before-deadline",
      "changed_relation": "Leaving is followed by opening another document before the old timer deadline.",
      "expected_changed_effects": [
        "switch-before-deadline"
      ]
    },
    {
      "left": "close-before-deadline",
      "right": "same-document-reopen",
      "changed_relation": "The same document reopens before the previous batch would expire.",
      "expected_changed_effects": [
        "same-document-reopen"
      ]
    },
    {
      "left": "switch-before-deadline",
      "right": "reentrant-switch-on-flush",
      "changed_relation": "An inline save notification requests C before the outer open B returns.",
      "expected_changed_effects": [
        "reentrant-switch-on-flush"
      ]
    },
    {
      "left": "reentrant-switch-on-flush",
      "right": "reentrant-close-on-flush",
      "changed_relation": "Inline navigation changes from open C to close while outer open B is pending.",
      "expected_changed_effects": [
        "reentrant-close-on-flush"
      ]
    },
    {
      "left": "reentrant-switch-on-flush",
      "right": "reentrant-timer-save",
      "changed_relation": "The save notification occurs at the quiet deadline instead of during leaving.",
      "expected_changed_effects": [
        "reentrant-timer-save"
      ]
    },
    {
      "left": "reentrant-timer-save",
      "right": "reentrant-edit",
      "changed_relation": "The inline callback edits the active document instead of navigating away.",
      "expected_changed_effects": [
        "reentrant-edit"
      ]
    },
    {
      "left": "preview-delay",
      "right": "preview-hide",
      "changed_relation": "Hide occurs before the preview quiet deadline.",
      "expected_changed_effects": [
        "preview-hide"
      ]
    },
    {
      "left": "preview-hide",
      "right": "preview-reuse",
      "changed_relation": "A fresh query is issued after hide before the old deadline.",
      "expected_changed_effects": [
        "preview-reuse"
      ]
    },
    {
      "left": "close-before-deadline",
      "right": "closed-empty",
      "changed_relation": "No selected document accepts the edit; close is idempotent and creates no work",
      "expected_changed_effects": [
        "closed-empty"
      ]
    },
    {
      "left": "close-before-deadline",
      "right": "empty-text",
      "changed_relation": "Accepted departing text is empty rather than nonempty; it remains a legal persisted value",
      "expected_changed_effects": [
        "empty-text"
      ]
    },
    {
      "left": "close-before-deadline",
      "right": "dispose-before-deadline",
      "changed_relation": "Disposal replaces close, detaching the integration while still committing document-owned pending work",
      "expected_changed_effects": [
        "dispose-before-deadline"
      ]
    }
  ]
}
