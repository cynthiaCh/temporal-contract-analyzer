      "line": 1,
      "excerpt": "The Controller accepts start, close, reopen(token), snapshot and terminal dispose. Requests use injected check(token) promises/futures; timers use schedule(callback,delay), cancel(handle). State fields visible/loading/retryScheduled/checkCount/completed/token are observable. Native driver supplies the same operations via real corresponding runtime callbacks. The target task applies only to the foreground component; the background service outlives its visual panel."
    },
    {
      "path": "base/src/workspace.js",
      "line": 1,
      "excerpt": "import $ from 'jquery';"
    },
    {
      "path": "base/src/workspace.js",
      "line": 2,
      "excerpt": "export function createController(host){const node=$(host.element);node.data('operation',{});const state=node.data('operation'),publish=()=>node.text(String(state.checkCount||0));"
    },
    {
      "path": "base/src/workspace.js",
      "line": 3,
      "excerpt": "const {config,env}=host;const s=state;Object.assign(s,{visible:true,loading:false,retryScheduled:false,checkCount:0,completed:[],token:config.token,generation:0,handle:null,disposed:false});"
    },
    {
      "path": "base/src/workspace.js",
      "line": 4,
      "excerpt": "function invalidate(){s.generation++;if(s.handle!==null)env.cancel(s.handle);s.handle=null;s.retryScheduled=false;s.loading=false;publish();}"
    },
    {
      "path": "base/src/workspace.js",
      "line": 5,
      "excerpt": "function check(born){const captured=s.token;s.loading=true;s.checkCount++;publish();env.check(captured).then(ready=>{if(s.disposed||(false&&born!==s.generation))return;if(ready){s.loading=false;s.retryScheduled=false;s.handle=null;if(!s.completed.includes(captured))s.completed.push(captured);}else if((config.background||false)&&true){s.retryScheduled=true;s.handle=env.schedule(()=>{if(s.disposed||(false&&born!==s.generation))return;s.handle=null;s.retryScheduled=false;check(born);},10);}else s.loading=false;publish();});}"
    },
    {
      "path": "base/src/workspace.js",
      "line": 6,
      "excerpt": "const operations={start(){invalidate();s.visible=true;check(s.generation);},close(){s.visible=false;if((false&&!config.background)||false)invalidate();publish();},reopen(token){invalidate();s.token=token;s.visible=true;check(s.generation);},snapshot(){return {visible:s.visible,loading:s.loading,retryScheduled:s.retryScheduled,checkCount:s.checkCount,completed:[...s.completed],token:s.token};},dispose(){s.disposed=true;invalidate();}};"
    },
    {
      "path": "base/src/workspace.js",
      "line": 7,
      "excerpt": "const command=(name,args=[])=>operations[name](...args);"
    },
    {
      "path": "base/src/workspace.js",
      "line": 8,
      "excerpt": "node.on('operation:command.scope',(event,name,args)=>command(name,args));return {command:(name,args)=>name==='snapshot'?command(name,args):node.triggerHandler('operation:command.scope',[name,args]),dispose(){command('dispose',[]);node.off('.scope');node.removeData('operation');}};}"
    }
