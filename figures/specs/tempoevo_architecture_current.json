  "title": "TempoEvo：时序契约引导的代码修复与经验演进",
  "subtitle": "AST 时序线索提取、独立修复与评分、人工审核及跨任务经验演进",
  "description": "当前默认实现的工作流。原始任务与源码经 AST 和 LLM 分析形成候选 Contract；程序检索冻结合格经验；Coding Agent 从相同输入独立修复两次，程序评分；LLM 根据两次补丁、评分和源证据反思，返回 no_update 或一条新增/修订候选。候选经准确版本人工内容审核、实际来源与跨来源效果验证及授权检查后启用。留出评估只读冻结经验且不回流。",
  "implementation": {
    "commit": "8326700",
    "date": "2026-11-12",
    "review_policy": "human-content-only-v1",
    "sources": [
      "temporal_contract_analyzer/experience_workflow.py",
      "temporal_contract_analyzer/experience_development.py",
      "temporal_contract_analyzer/experience_routing.py",
      "temporal_contract_analyzer/experience_screening.py",
      "temporal_contract_analyzer/experience_lifecycle.py",
      "temporal_contract_analyzer/experience_evaluation.py"
    ],
    "assumptions": [
      "图示当前新批次的默认策略；历史 AI 审核策略不在图内。",
      "两次初始修复为独立重复，不构成固定三轮反馈修订契约。",
      "每个迁移来源的 old/new 各执行两次；来源旧条件复用两次初始修复。",
      "经验库指可默认投放的合格活动版本；候选和未启用记录仍可保存于同一物理存储。",
      "反思为 new 或 revise 时进入人工审核；no_update 直接归档。",
      "原图的蓝、绿、紫分区和圆角线框作为样式参考。"
    ]
  },
