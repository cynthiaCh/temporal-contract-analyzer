&&v.handle==h){notice(v,h);}else h.cancel();return h;}\n  public Attempt retry(){Visit v=visit;if(v==null||v.handle==null||disposed)return null;v.handle.cancel(); Visit accepted=v;Attempt h=enqueue(accepted,\"retry\");if(current(accepted)&&accepted.handle==h)notice(accepted,h);else h.cancel();return h;}\n  public void hide(){serial++;Visit old=visit;visit=null;if(old!=null)release(old);}\n  public void dispose(){if(disposed)return;disposed=true;hide();for(Attempt h:new ArrayList<>(tasks))h.cancel();}\n  public Map<String,Object> snapshot(){Visit v=visit;return obj(\"visitId\",v==null?null:v.id,\"fileId\",v==null?null:v.file.id,\"attemptId\",v==null||v.handle==null?null:v.handle.number,\"disposed\",disposed,\"attempts\",ledger.number);}\n }\n public static Client create(Environment env){return new Broker(env);}\n public static class Telemetry {public final Runnable stop;public Telemetry(Environment env,File file){int callback=env.bind(packet->{Consumer<Object> deliver=frame->env.call(\"recordDelta\",frame);Map<?,?> value=(Map<?,?>)env.call(\"decode\",file.token,packet,env.bind(deliver));if(!Boolean.TRUE.equals(value.get(\"deferred\")))deliver.accept(value.get(\"frame\"));});int subscription;env.call(\"start\",file.token);subscription=((Number)env.call(\"listen\",file.token,callback)).intValue(); stop=()->env.call(\"unlisten\",file.token,subscription);}}\n}\n"
