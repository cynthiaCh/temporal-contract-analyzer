        "src/subscription.js": "// The decoder may return a value or a Promise (compressed network frames).\n// EventTarget removal detaches reception; an already started decode still settles.\nexport function subscribeChannel(channel, bootstrapMode, receive, signal) {\n  let active = true;\n  const deliver = (value) => {\n    if (active) receive(value);\n  };\n  const listener = (event) => {\n    if (!active) return;\n    const decoded = channel.decode(event.detail);\n    if (decoded && typeof decoded.then === \"function\") decoded.then(deliver);\n    else deliver(decoded);\n  };\n  const release = () => {\n    active = false;\n    channel.target.removeEventListener(\"presence\", listener);\n    signal?.removeEventListener(\"abort\", release);\n  };\n  if (signal?.aborted) {\n    active = false;\n    return release;\n  }\n  signal?.addEventListener(\"abort\", release, { once: true });\n  channel.target.addEventListener(\"presence\", listener);\n  try {\n    channel.connect(bootstrapMode);\n  } catch (error) {\n    release();\n    throw error;\n  }\n  return release;\n}\n",
        "src/workspace-navigation.js": "import { createPresencePanel } from \"./presence-panel.js\";\n\n// Presence publication can synchronously select a different room or hide the\n// panel (for example, a room chooser reacting to an empty bootstrap snapshot).\n// Reusing a transport object on a later visit is supported by the workspace.\nexport function createWorkspaceNavigation(renderState) {\n  const panel = createPresencePanel((value) => renderState(value, navigation));\n  const navigation = {\n    select(channel, mode = \"synchronous\") { panel.show(channel, mode); },\n    hide() { panel.close(); },\n  };\n  return navigation;\n}\n",
        "tests/visible.mjs": "// Public examples only. Authored from task/source/public README, not oracle files.\nimport {pathToFileURL} from 'node:url';\nimport path from 'node:path';\nconst root=process.argv[2];\nconst {createPresencePanel,renderPresence}=await import(pathToFileURL(path.join(root,'src/presence-panel.js')));\nconst {createPresenceChannel}=await import(pathToFileURL(path.join(root,'src/channel.js')));\nconst {createWorkspaceNavigation}=await import(pathToFileURL(path.join(root,'src/workspace-navigation.js')));\nconst {collectMetrics}=await import(pathToFileURL(path.join(root,'src/metrics-consumer.js')));\nconst observations=[];\nconst eq=(a,b)=>JSON.stringify(a)===JSON.stringify(b);\nasync function check(id,expected,run){try{const actual=await run();observations.push({check:id,expected,actual,passed:eq(actual,expected)});}catch(e){observations.push({check:id,expected,actual:{error:e.message},passed:false});}}\nawait check('public_synchronous_bootstrap',['A:bootstrap','A:update'],async()=> (await renderPresence('A','synchronous')).events);\nawait check('public_deferred_bootstrap',['A:bootstrap','A:update'],async()=> (await renderPresence('A','deferred')).events);\nawait check('public_metrics_delta_only',['M:update'],async()=> (await collectMetrics('M')).events);\nawait check('public_close_detaches',[],()=>{const log=[];const p=createPresencePanel(v=>log.push(v));const c=createPresenceChannel('C');p.show(c,'synchronous');log.length=0;p.close();c.emitUpdate();return log;});\nawait check('public_switch_owner',['B:update'],()=>{const log=[];const p=createPresencePanel(v=>log.push(v));const a=createPresenceChannel('A'),b=createPresenceChannel('B');p.show(a);p.show(b);log.length=0;a.emitUpdate();b.emitUpdate();return log;});\nfunction pending(){const target=new EventTarget(),tickets=[];return {target,connect(){},decode(value){return new Promise(resolve=>tickets.push({value,resolve}));},emit(value){const event=new Event('presence');Object.defineProperty(event,'detail',{value});target.dispatchEvent(event);},tickets};}\nconst settle=async()=>{await Promise.resolve();await Promise.resolve();};\nawait check('public_pending_decode_after_close',[],async()=>{const log=[],c=pending();const p=createPresencePanel(v=>log.push(v));p.show(c);c.emit('old');p.close();for(const t of c.tickets)t.resolve(t.value);await settle();return log;});\nawait check('public_pending_decode_same_channel_reopen',['new'],async()=>{const log=[],c=pending();const p=createPresencePanel(v=>log.push(v));p.show(c);c.emit('old');p.close();p.show(c);c.emit('new');for(const t of c.tickets)t.resolve(t.value);await settle();return log;});\nawait check('public_inline_navigation_keeps_new_owner',['A:bootstrap','B:bootstrap','B:update'],()=>{const log=[],a=createPresenceChannel('A'),b=createPresenceChannel('B');let nav;nav=createWorkspaceNavigation(value=>{log.push(value);if(value==='A:bootstrap')nav.select(b);});nav.select(a);a.emitUpdate();b.emitUpdate();nav.hide();return log;});\nconsole.log(JSON.stringify({passed:observations.every(o=>o.passed),observations,regressions:[],unknowns:[]}));\n"
