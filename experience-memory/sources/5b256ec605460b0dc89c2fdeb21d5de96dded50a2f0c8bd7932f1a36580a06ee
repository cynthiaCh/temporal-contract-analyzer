        "src/Workflow.java": "import java.util.*;\nimport java.util.function.*;\n// Command broker, visit identity and transfer attempt are separate objects.\npublic class Workflow {\n public interface Environment {Object call(String method,Object... args);int bind(Consumer<Object> callback);}\n public static Map<String,Object> obj(Object... values){Map<String,Object> m=new LinkedHashMap<>();for(int i=0;i<values.length;i+=2)m.put((String)values[i],values[i+1]);return m;}\n public static class File {public final String id;public final int token,size;public final boolean feed;public File(String id,int token,int size,boolean feed){this.id=id;this.token=token;this.size=size;this.feed=feed;}}\n public static class Visit {final int id;final File file;Attempt handle;Visit(int id,File file){this.id=id;this.file=file;}}\n public static class Attempt {\n  public final File file;public final int number;public boolean aborted;final Environment env;Runnable stop=()->{};\n  private long arrived, displayed;\n  private Attempt(Environment env,File file,int number){this.env=env;this.file=file;this.number=number;}\n  public Attempt(Environment env,File file,int number,IntSupplier active,Consumer<Object> audit,BiConsumer<Object,Integer> view){\n   this(env,file,number);begin(active,audit,view,()->true);\n  }\n  private void begin(IntSupplier active,Consumer<Object> audit,BiConsumer<Object,Integer> view,BooleanSupplier eligible){\n   env.call(\"transport\",file.token,number);\n   if(file.feed&&!aborted&&eligible.getAsBoolean()){\n    int callback=env.bind(packet->{\n     if(aborted||!eligible.getAsBoolean())return;\n     final long sequence=++arrived;final int order=active.getAsInt();\n     Consumer<Object> deliver=frame->{\n      audit.accept(frame);\n      if(!aborted&&eligible.getAsBoolean()&&sequence>displayed){displayed=sequence;view.accept(frame,order);}\n     };\n     Map<?,?> value=(Map<?,?>)env.call(\"decode\",file.token,packet,env.bind(deliver));if(!Boolean.TRUE.equals(value.