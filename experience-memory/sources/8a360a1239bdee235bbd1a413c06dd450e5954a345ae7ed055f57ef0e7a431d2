        "src/coordinator.js": "import {trailing} from './services.js';\nclass BufferBank {constructor(){this.entries=new Map();}get(env,id){if(!this.entries.has(id))this.entries.set(id,trailing(env.timers,120,text=>env.store.write(id,text)));return this.entries.get(id);}}\nexport function createCoordinator(env,getView,setView){\n if(!env.store.documentBuffers)env.store.documentBuffers=new BufferBank();const bank=env.store.documentBuffers;\n let request=0;\n function retire(){const old=getView();setView(null);if(old&&!false)old.stop();env.renderDocument(null);if(old){}if(old&&false)old.stop();}\n const api={open(id){const mine=++request;retire();if(true&&mine!==request)return;const buffer=bank.get(env,id),stop=env.store.subscribe(event=>{if(event.id===id)env.renderStatus(event);});setView({id,buffer,stop});env.renderDocument({id,text:env.store.read(id)});},edit(text){const view=getView();if(view){env.store.write(view.id,text);}},close(){++request;retire();},dispose(){api.close();}};\n return api;\n}\n",
        "src/services.js": "export function createDraftStore(initial = {}) {\n  const records = new Map(Object.entries(initial)), subscriptions = new Map();\n  let serial = 0, revision = 0;\n  return {\n    read: key => records.get(key) ?? '',\n    write(id, text) {\n      records.set(id, text);\n      const event = {id, text, revision: ++revision};\n      for (const [key, callback] of [...subscriptions]) if (subscriptions.has(key)) callback(event);\n      return event;\n    },\n    subscribe(callback) { const key = ++serial; subscriptions.set(key, callback); return () => subscriptions.delete(key); },\n  };\n}\nexport function trailing(timers, wait, consume) {\n  let ticket = null, value = null;\n  const retire = () => { if (ticket !== null) timers.cancel(ticket); ticket = null; value = null; };\n  const flush = () => { const saved = value; retire(); if (saved !== null) consume(saved); };\n  return {\n    push(text) { if (ticket !== null) timers.cancel(ticket); value = text; ticket = timers.schedule(flush, wait); },\n    flush, cancel: retire,\n  };\n}\nexport function createSearchPreview({timers, publish}) {\n  const task = trailing(timers, 40, query => publish({query}));\n  return {query: text => task.push(text), hide: () => task.cancel()};\n}\n",
