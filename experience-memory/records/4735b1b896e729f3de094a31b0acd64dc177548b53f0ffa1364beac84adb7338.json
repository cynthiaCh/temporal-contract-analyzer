  "taxonomy_version": "temporal-obligation-taxonomy-7-v1",
  "labels": [
    "O",
    "B",
    "L",
    "I"
  ],
  "requires": [
    "boundary_persistence",
    "deferred_batch",
    "inline_reentry"
  ],
  "excludes": [
    "discard_boundary_policy",
    "different_ownership_policy"
  ],
  "rules": [
    {
      "id": "R01",
      "category": "applicability",
      "body": "Apply when immediate document persistence is replaced with reusable trailing work, the document buffer outlives its view subscription, and synchronous save callbacks can navigate. Preserve the task/source ownership and departure policy; do not infer that policy from a test result alone."
    },
    {
      "id": "R02",
      "category": "event_relation",
      "body": "Bind each accepted edit to its originating document. Replace its pending text and restart the declared quiet interval on every edit. Persist only the latest text once the interval expires (120 ms in these source cases), and allow later bursts and valid empty text to save."
    },
    {
      "id": "R03",
      "category": "event_relation",
      "body": "Consume and clear the completed batch state before invoking callback-capable save work. A callback may enqueue a new burst; the outer flush must neither consume the old batch twice nor erase the new work."
    },
    {
      "id": "R04",
      "category": "preservation",
      "body": "Keep document-buffer ownership separate from badge subscription cleanup. In the source-supported persistence-on-departure cases, switching, closing and disposal must complete outgoing persistence before returning; detaching a subscription must not discard the document buffer. Preserve same-document reopening and the no-current-view edit guard."
    },
    {
      "id": "R05",
      "category": "event_relation",
      "body": "Publish retirement state and finish cleanup of the captured departing subscription before a save can reenter. After any callback-capable save or publication, check that the initiating navigation still owns its generation before installing a destination or clearing rendered state. Preserve nested open/close and newly queued edits."
    },
    {
      "id": "R06",
      "category": "preservation",
      "body": "Preserve public interfaces, original document identities and text, document/status rendering and event payload semantics. Complete cleanup for captured old resources without overwriting newer navigation or subscriptions."
    },
    {
      "id": "R07",
      "category": "exclusion",
      "body": "Do not transfer persistent-document departure rules to transient preview work or incompatible ownership/discard policies. Preserve the preview quiet interval, cancellation on hide and later reuse (40 ms in these source cases)."
    },
    {
      "id": "R08",
      "category": "verification",
      "body": "Use controlled clocks and synchronous callbacks to check no early write, latest-value delivery, deadline restart, subsequent bursts, empty text, switch/close/dispose, same-document reopening, original-document binding, nested navigation, status cleanup and preview cancellation/reuse. Passing these checks is source evidence, not proof of causal or cross-task effectiveness."
    }
  ],
