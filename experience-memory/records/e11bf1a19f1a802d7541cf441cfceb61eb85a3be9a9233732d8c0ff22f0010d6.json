    "shared_lifetime"
  ],
  "excludes": [
    "different_ownership_policy",
    "no_lazy_shared_mechanism"
  ],
  "rules": [
    {
      "id": "R01",
      "category": "applicability",
      "body": "Apply where observers share longer-lived query/cache state, each physical fetch attempt owns its controller and completion, signal consumption is recorded lazily on actual access, and paused continuation resumes asynchronously."
    },
    {
      "id": "R02",
      "category": "event_relation",
      "body": "When the last observer departs a fresh online-mode query mounted entirely offline before entry, prevent later reconnect continuation from invoking its signal-consuming function with a live signal, independently of refetchOnReconnect. Cover both future scheduling and continuation callbacks already queued."
    },
    {
      "id": "R03",
      "category": "preservation",
      "body": "Keep shared consumption bookkeeping separate from attempt-owned cancellation resources. Do not move consumption state into an attempt solely because its controller is attempt-local; honor the original public ownership and lazy access semantics."
    },
    {
      "id": "R04",
      "category": "preservation",
      "body": "Preserve remaining observers, inert unknown departures, supported unconsumed active completion into cache, consumed-work cancellation and restoration, originating-attempt settlement, observer reuse and generation isolation. Stale completion must not settle or overwrite a newer attempt."
    },
    {
      "id": "R05",
      "category": "exclusion",
      "body": "Do not cancel every paused, unobserved or not-yet-entered fetch. Distinguish the abandoned fresh offline attempt from supported background work and shared fetches; respect incompatible ownership policies and absence of the lazy shared mechanism."
    },
    {
      "id": "R06",
      "category": "preservation",
      "body": "Preserve synchronous initial online entry, asynchronous completion, focus-gated paused continuation, network modes including always/offlineFirst, and explicitly scheduled retries. Keep the repair within product source and preserve public interfaces and build/test configuration."
    },
    {
      "id": "R07",
      "category": "verification",
      "body": "Check final-observer offline departure and reconnect with refetchOnReconnect varied, including queued continuation. Independently verify remaining observers, unknown unsubscribe, later signal consumption, unconsumed background completion, cancellation restoration, cached continuation, retry timing and late completion. Derive expectations from public task/source obligations."
    }
  ],
