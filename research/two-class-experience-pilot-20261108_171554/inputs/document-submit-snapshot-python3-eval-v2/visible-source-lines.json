    {
      "line": 52,
      "text": "class Trailing:"
    },
    {
      "line": 53,
      "text": "    def __init__(self, env, delay, work):"
    },
    {
      "line": 54,
      "text": "        self.env, self.delay, self.work = env, delay, work"
    },
    {
      "line": 55,
      "text": "        self.handle = self.pending = None"
    },
    {
      "line": 56,
      "text": ""
    },
    {
      "line": 57,
      "text": "    def push(self, value):"
    },
    {
      "line": 58,
      "text": "        if self.handle is not None:"
    },
    {
      "line": 59,
      "text": "            self.env.cancel(self.handle)"
    },
    {
      "line": 60,
      "text": "        self.pending = value"
    },
    {
      "line": 61,
      "text": "        self.handle = self.env.schedule(self.flush, self.delay)"
    },
    {
      "line": 62,
      "text": ""
    },
    {
      "line": 63,
      "text": "    def flush(self):"
    },
    {
      "line": 64,
      "text": "        if self.handle is not None:"
    },
    {
      "line": 65,
      "text": "            self.env.cancel(self.handle)"
    },
    {
      "line": 66,
      "text": "        value = self.pending"
    },
    {
      "line": 67,
      "text": "        self.handle = self.pending = None"
    },
    {
      "line": 68,
      "text": "        if value is not None:"
    },
    {
      "line": 69,
      "text": "            self.work(value)"
    },
    {
      "line": 70,
      "text": ""
    },
    {
      "line": 71,
      "text": "    def cancel(self):"
    },
    {
      "line": 72,
      "text": "        if self.handle is not None:"
    },
    {
      "line": 73,
      "text": "            self.env.cancel(self.handle)"
    },
    {
      "line": 74,
      "text": "        self.handle = self.pending = None"
