    {
      "line": 104,
      "text": "        self.current = Visit(key, self.env.store.read(key), token, task)"
    },
    {
      "line": 105,
      "text": "        self.env.output('document', dict(id=key, text=self.current.text))"
    },
    {
      "line": 106,
      "text": ""
    },
    {
      "line": 107,
      "text": "    def edit(self, text):"
    },
    {
      "line": 108,
      "text": "        if self.current is not None:"
    },
    {
