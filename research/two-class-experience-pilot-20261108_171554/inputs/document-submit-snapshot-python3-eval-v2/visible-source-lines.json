      "text": ""
    },
    {
      "line": 5,
      "text": "class Store:"
    },
    {
      "line": 6,
      "text": "    def __init__(self, records):"
    },
    {
      "line": 7,
      "text": "        self.records = dict(records)"
    },
    {
      "line": 8,
      "text": "        self.listeners = {}"
    },
    {
      "line": 9,
      "text": "        self.serial = self.revision = 0"
    },
    {
      "line": 10,
      "text": ""
    },
    {
      "line": 11,
      "text": "    def read(self, key):"
    },
    {
      "line": 12,
      "text": "        return self.records.get(key, '')"
    },
    {
      "line": 13,
      "text": ""
    },
    {
      "line": 14,
      "text": "    def subscribe(self, listener):"
    },
    {
      "line": 15,
      "text": "        self.serial += 1"
    },
    {
      "line": 16,
      "text": "        token = self.serial"
    },
    {
      "line": 17,
      "text": "        self.listeners[token] = listener"
    },
    {
      "line": 18,
      "text": "        return token"
    },
    {
      "line": 19,
      "text": ""
    },
    {
      "line": 20,
      "text": "    def stop(self, token):"
    },
    {
      "line": 21,
      "text": "        self.listeners.pop(token, None)"
    },
    {
      "line": 22,
      "text": ""
    },
    {
      "line": 23,
      "text": "    def write(self, key, text):"
    },
    {
      "line": 24,
      "text": "        self.records[key] = text"
    },
    {
      "line": 25,
      "text": "        self.revision += 1"
    },
    {
      "line": 26,
      "text": "        event = dict(id=key, text=text, revision=self.revision)"
    },
    {
      "line": 27,
      "text": "        for token, listener in list(self.listeners.items()):"
    },
    {
      "line": 28,
      "text": "            if token in self.listeners:"
    },
    {
      "line": 29,
      "text": "                listener(event)"
    },
    {
      "line": 30,
      "text": "        return event"
    },
    {
