  "not_independently_mutant_calibrated": [
    "departing badge detaches before delivery while active badge stays live",
    "discard-on-hide and preview reuse (positive preservation schedules only)",
    "consumed batch cannot repeat on cancelled timer",
    "inline edit enqueues a new batch that survives prior callback return",
    "accepted archive work is never dropped on visit invalidation (positive schedules; retarget mutant covers different entry-value failure)",
    "later edits cannot mutate an already returned/archive receipt value",
    "pending document write ownership retargeting independent from archive retargeting"
  ],
  "positive_preservation_schedules": [
    {
      "id": "quiet-burst",
      "description": "A burst at 0/30/80 ms saves only latest text at 200 ms after maintenance; immediate baseline saves every edit.",
      "events": [
        "open-a",
        "edit-alpha-0",
        "edit-beta-30",
        "edit-gamma-80",
        "before-deadline-199",
        "deadline-200"
      ]
    },
    {
      "id": "second-burst",
      "description": "A later burst receives its own complete quiet interval and saves after the first batch retired.",
      "events": [
        "open-a",
        "edit-one-0",
        "save-one-120",
        "edit-two-120",
        "edit-three-150",
        "save-three-270"
      ]
    },
    {
      "id": "close-before-deadline",
      "description": "Close at 20 ms commits document-owned text before return after retiring its badge; no stale timer repeats it.",
      "events": [
        "open-a",
        "edit-a",
        "close-20",
        "read-after-return",
        "advance-past-old-deadline"
      ]
    },
    {
      "id": "switch-before-deadline",
      "description": "Switch before the first deadline saves A before return and never retargets its pending text into B.",
      "events": [
        "open-a",
        "edit-a",
        "open-b-20",
        "read-a-and-b",
        "edit-b",
        "deadline-b-140"
      ]
    },
    {
      "id": "same-document-reopen",
      "description": "Close and reopen the same document before the deadline restore latest text without retaining an old batch.",
      "events": [
        "open-a",
        "edit-first-visit",
        "close-20",
        "reopen-a",
        "read-restored-text",
        "edit-second-visit",
        "deadline-140",
        "close-twice"
      ]
    },
    {
      "id": "reentrant-switch-on-flush",
      "description": "A pending flush notifies inline and opens C inside outer open B; the newer navigation survives outer return. The immediate baseline already notified before the callback was armed.",
      "events": [
        "open-a",
        "edit-a",
        "arm-on-saved-open-c",
        "outer-open-b",
        "flush-notification-if-pending",
        "nested-open-c-if-notified",
        "outer-return",
        "edit-selected-document"
      ]
    },
    {
      "id": "reentrant-close-on-flush",
      "description": "A pending flush notifies inline and closes inside outer open B; outer navigation must not reopen it. The immediate baseline has no pending notification.",
      "events": [
        "open-a",
        "edit-a",
        "arm-on-saved-close",
        "outer-open-b",
        "flush-notification-if-pending",
        "nested-close-if-notified",
        "outer-return",
        "edit-if-active"
      ]
    },
    {
      "id": "reentrant-timer-save",
      "description": "A timer-fired save opens B through inline notification; the detached A badge is skipped and B subsequently saves with an active badge.",
      "events": [
        "open-a",
        "arm-on-saved-open-b",
        "edit-a",
        "save-a-and-nested-open-b",
        "edit-b",
        "save-b"
      ]
    },
    {
      "id": "reentrant-edit",
      "description": "An inline notification edits the still-active document again; the new burst survives retirement of the first batch.",
      "events": [
        "open-a",
        "arm-on-saved-edit-two",
        "edit-one",
        "save-one-and-edit-two",
        "before-second-deadline",
        "save-two"
      ]
    },
    {
      "id": "preview-delay",
      "description": "Preview emits exactly once at either its original 40 ms quiet interval or the separately authorized 120 ms interval.",
      "events": [
        "query-0",
        "check-39",
        "check-40",
        "check-119",
        "check-120"
      ]
    },
    {
      "id": "preview-hide",
      "description": "Hiding a preview discards pending query work and never flushes it in either authorization arm.",
      "events": [
        "query-0",
        "hide-10",
        "check-hide-return",
        "advance-600"
      ]
    },
    {
      "id": "preview-reuse",
      "description": "A hidden then reused preview publishes only its new query with the same quiet interval as an uninterrupted preview.",
      "events": [
        "query-old-0",
        "hide-10",
        "query-new-20",
        "check-59",
        "check-60",
        "check-139",
        "check-140"
      ]
    },
    {
      "id": "submit-before-deadline",
      "description": "Submit an active pending edit at 20 ms; verify store at archive capture and return, immutable receipt, live notice, and no duplicate save.",
      "events": [
        "prepare-selection",
        "accept-submit",
        "capture-boundary",
        "submit-return",
        "quiescence"
      ]
    },
    {
      "id": "submit-after-deadline",
      "description": "The same submission occurs after the quiet save, requiring no duplicate commit.",
      "events": [
        "prepare-selection",
        "accept-submit",
        "capture-boundary",
        "submit-return",
        "quiescence"
      ]
    },
    {
      "id": "submit-switch-on-flush",
      "description": "Arm save callback after edit, submit while pending, callback opens C: keep A receipt but suppress A notice; then submit C successfully.",
      "events": [
        "prepare-selection",
        "accept-submit",
        "capture-boundary",
        "submit-return",
        "quiescence"
      ]
    },
    {
      "id": "submit-close-on-flush",
      "description": "The pending submit save closes the editor inline: keep and return A receipt with no visible notice.",
      "events": [
        "prepare-selection",
        "accept-submit",
        "capture-boundary",
        "submit-return",
        "quiescence"
      ]
    },
    {
      "id": "submit-reopen-on-flush",
      "description": "Save callback closes then reopens A: same document key must not revive the old visit notice; later new-visit submit remains live.",
      "events": [
        "prepare-selection",
        "accept-submit",
        "capture-boundary",
        "submit-return",
        "quiescence"
      ]
    },
    {
      "id": "submit-reentrant-edit",
      "description": "During a pending submit save, callback edits the same visit: the receipt retains entry text and the subsequent batch saves on its own deadline.",
      "events": [
        "prepare-selection",
        "accept-submit",
        "capture-boundary",
        "submit-return",
        "quiescence"
      ]
    },
    {
      "id": "submit-empty",
      "description": "Submission with no active document returns null, archives nothing, and schedules no work.",
      "events": [
        "closed-workspace",
        "submit",
        "submit-return"
      ]
    },
    {
      "id": "dispose-before-deadline",
      "description": "Dispose detaches integration before pending departure commit and keeps closed actions inert.",
      "events": [
        "entry",
        "controlled-boundary",
        "return",
        "quiescence"
      ]
    },
    {
      "id": "repeated-submit-empty-text",
      "description": "Empty string is valid pending text; two accepts make two receipts but do not duplicate the save.",
      "events": [
        "entry",
        "controlled-boundary",
        "return",
        "quiescence"
      ]
    },
    {
      "id": "large-unicode-value",
      "description": "Large Unicode/newline text survives the native value handoff; subsequent edits cannot change receipt values.",
      "events": [
        "entry",
        "controlled-boundary",
        "return",
        "quiescence"
      ]
    }
  ],
