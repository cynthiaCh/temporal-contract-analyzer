      "line": 9,
      "text": " invoke(q,a){a.queued=false;if(!this.active(q,a))return;q.state.fetchStatus='fetching';q.consumed=false;const context={key:q.key,attempt:a.number};Object.defineProperty(context,'signal',{enumerable:true,get(){q.consumed=true;return a.controller.signal;}});let value;try{value=this.host.queryFn(context);}catch(e){value=Promise.reject(e);}Promise.resolve(value).then(value=>{if(!this.active(q,a))return;a.settled=true;q.state={...q.state,data:value,status:'success',fetchStatus:'idle'};this.project(q);},()=>{if(!this.active(q,a))return;if(!a.retryCancelled&&a.failures<(a.options.retry||0)){a.failures++;this.host.timers.schedule(()=>{if(!this.active(q,a))return;if(a.retryCancelled){a.settled=true;q.state={...q.state,status:'error',fetchStatus:'idle'};}else if(this.eligible(a))this.invoke(q,a);else q.state.fetchStatus='paused';this.project(q);},a.options.retryDelay||10);}else{a.settled=true;q.state={...q.state,status:'error',fetchStatus:'idle'};}this.project(q);});this.project(q);}"
    },
    {
      "line": 10,
      "text": " resume(q){const a=q.attempt;if(a&&this.active(q,a)&&q.state.fetchStatus==='paused'&&this.eligible(a)&&!a.queued){a.queued=true;Promise.resolve().then(()=>{a.queued=false;if(!this.active(q,a))return;if(a.failures&&a.retryCancelled){a.settled=true;q.state={...q.state,status:'error',fetchStatus:'idle'};this.project(q);return;}this.invoke(q,a);});}}"
    },
    {
      "line": 11,
      "text": " subscribe(key,options={}){let q=this.cache.get(key);if(!q){const data=options.initialData===undefined?null:options.initialData;q={key,state:{status:data===null?'pending':'success',fetchStatus:'idle',data},observers:new Set(),attempt:null,consumed:false};this.cache.set(key,q);}const handle=++this.serial;this.handles.set(handle,q);q.observers.add(handle);if(q.attempt&&!q.attempt.settled){q.attempt.retryCancelled=false;this.resume(q);}else{const a=new Attempt(++this.fetchSerial,q.state,options);q.attempt=a;if((options.networkMode||'online')!=='online'||this.connected)this.invoke(q,a);else q.state.fetchStatus='paused';}this.project(q);return handle;}"
    },
