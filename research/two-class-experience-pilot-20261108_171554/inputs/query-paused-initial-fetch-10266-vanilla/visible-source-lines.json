      "text": " constructor(host,initial={}){this.host=host;this.cache=new Map();this.handles=new Map();this.connected=initial.online!==false;this.focused=initial.focused!==false;this.serial=0;this.fetchSerial=0;this.project=()=>{};}"
    },
    {
      "line": 6,
      "text": " eligible(a){return this.focused&&((a.options.networkMode||'online')==='always'||this.connected);}"
    },
    {
