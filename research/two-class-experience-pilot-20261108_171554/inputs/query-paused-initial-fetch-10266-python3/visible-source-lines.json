    },
    {
      "line": 10,
      "text": "        if a.settled:return"
    },
    {
      "line": 11,
      "text": "        a.settled=True;q.state=dict(a.previous);q.state['fetchStatus']='idle';self.env.call('abort',q.key,a.number)"
    },
    {
      "line": 12,
      "text": "    def invoke(self,q,a):"
    },
    {
      "line": 13,
      "text": "        a.queued=False"
    },
    {
      "line": 14,
      "text": "        if not self.active(q,a):return"
    },
    {
      "line": 15,
      "text": "        q.state['fetchStatus']='fetching';q.consumed=False"
    },
    {
      "line": 16,
      "text": "        def consume(_):q.consumed=True;return None"
    },
    {
      "line": 17,
      "text": "        def complete(value):"
    },
    {
      "line": 18,
      "text": "            if not self.active(q,a):return"
    },
    {
      "line": 19,
      "text": "            if value['ok']:"
    },
