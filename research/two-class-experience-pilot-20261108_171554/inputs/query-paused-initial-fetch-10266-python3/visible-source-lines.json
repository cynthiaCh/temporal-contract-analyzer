      "line": 1,
      "text": "class Attempt:"
    },
    {
      "line": 2,
      "text": "    def __init__(self,number,previous,options):self.number=number;self.previous=dict(previous);self.options=options;self.settled=False;self.consumed=False;self.retry_cancelled=False;self.failures=0;self.queued=False"
    },
    {
      "line": 3,
      "text": "class Query:"
    },
    {
      "line": 4,
      "text": "    def __init__(self,key,data):self.key=key;self.state=dict(status='success' if data is not None else 'pending',fetchStatus='idle',data=data);self.observers=set();self.attempt=None;self.consumed=False"
    },
    {
      "line": 5,
      "text": "class Session:"
    },
    {
      "line": 6,
      "text": "    def __init__(self,env,initial):self.env=env;self.cache={};self.handles={};self.online=initial.get('online',True);self.focused=initial.get('focused',True);self.serial=0;self.fetch_serial=0"
    },
    {
      "line": 7,
      "text": "    def eligible(self,a):return self.focused and (a.options.get('networkMode','online')=='always' or self.online)"
    },
    {
      "line": 8,
      "text": "    def active(self,q,a):return q.attempt is a and not a.settled"
    },
    {
      "line": 9,
