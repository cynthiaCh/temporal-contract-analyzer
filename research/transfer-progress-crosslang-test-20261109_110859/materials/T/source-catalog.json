    {
      "id": "S0013",
      "file": "README.md",
      "line": 11,
      "start_column": 0,
      "end_column": 80,
      "quote": "An accepted retry always belongs to the file and visit present at entry, creates"
    },
    {
      "id": "S0014",
      "file": "README.md",
      "line": 12,
      "start_column": 0,
      "end_column": 77,
      "quote": "exactly one new attempt, and remains in the queue record even if cancellation"
