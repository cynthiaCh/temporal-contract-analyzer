      "quote": "Retry already cancels the previous transfer before enqueueing an accepted retry."
    },
    {
      "id": "S0012",
      "file": "README.md",
      "line": 10,
      "start_column": 80,
      "end_column": 132,
      "quote": " Preserve that behavior during progress maintenance."
