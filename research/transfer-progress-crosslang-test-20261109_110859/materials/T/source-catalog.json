    {
      "id": "S0028",
      "file": "README.md",
      "line": 27,
      "start_column": 0,
      "end_column": 80,
      "quote": "The accepted old retry must still enqueue and record once after such navigation."
    },
    {
      "id": "S0029",
      "file": "README.md",
      "line": 28,
      "start_column": 0,
      "end_column": 79,
      "quote": "Its newly created transfer is canceled immediately if its visit has ended; this"
