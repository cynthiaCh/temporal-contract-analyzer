          "command": "/runtime/node --experimental-default-type=module --input-type=module <<'EOF'\nimport assert from 'node:assert/strict';\nimport { createResource } from './src/session.js';\n\nconst checks=[];\nconst scheduled=[];\nconst cancelled=[];\nconst published=[];\nconst host={\n  check(token){\n    let resolve;\n    const promise=new Promise(r=>{resolve=r;});\n    checks.push({token,resolve});\n    return promise;\n  },\n  schedule(fn){const task={fn,cancelled:false};scheduled.push(task);return task;},\n  cancel(task){task.cancelled=true;cancelled.push(task);},\n  publish(state){published.push(state);}\n};\nconst flush=()=>new Promise(resolve=>queueMicrotask(resolve));\n\nconst resource=createResource(host,'download','first');\nresource.start();\nassert.equal(checks.length,1);\nassert.equal(checks[0].token,'first');\nchecks[0].resolve(false); await flush();\nassert.equal(resource.snapshot().completed.length,0);\nassert.equal(resource.snapshot().retryScheduled,true);\nassert.equal(scheduled.length,1);\nscheduled[0].fn();\nassert.equal(checks.length,2);\nassert.equal(checks[1].token,'first');\nchecks[1].resolve(false); await flush();\nassert.equal(scheduled.length,2);\nscheduled[1].fn();\nchecks[2].resolve(true); await flush();\nassert.deepEqual(resource.snapshot().completed,['first']);\nassert.equal(resource.snapshot().loading,false);\nassert.equal(resource.snapshot().retryScheduled,false);\n\nresource.reopen('second');\nassert.equal(checks[3].token,'second');\nchecks[3].resolve(false); await flush();\nconst secondTask=scheduled[2];\nresource.close();\nassert.equal(secondTask.cancelled,true);\nassert.equal(resource.snapshot().visible,false);\nconst beforeDisposed=checks.length;\nresource.reopen('third');\nassert.equal(checks.length,beforeDisposed+1);\nchecks.at(-1).resolve(false); await flush();\nconst disposalTask=scheduled.at(-1);\nresource.dispose();\nassert.equal(disposalTask.cancelled,true);\nassert.equal(resource.snapshot().completed.includes('third