l(renders, []);\n}\n\n{\n  const pending = deferred(), records = [], renders = [];\n  const controller = createController({ service: { commit: () => pending.promise }, audit: { record: value => records.push(value) }, render: value => renders.push(value) });\n  controller.open('doc', 'actor');\n  const submitted = controller.submit();\n  pending.reject(new Error('nope'));\n  await assert.rejects(submitted, /nope/);\n  assert.deepEqual(records, []);\n  assert.deepEqual(renders, [{ status: 'error', doc: 'doc' }]);\n}\n\n{\n  const renders = [];\n  const controller = createController({ service: { commit: () => { throw new Error('nope'); } }, audit: { record: () => assert.fail('should not audit') }, render: value => renders.push(value) });\n  controller.open('doc', 'actor');\n  await assert.rejects(controller.submit(), /nope/);\n  assert.deepEqual(renders, [{ status: 'error', doc: 'doc' }]);\n}\n\nconsole.log('controller async-submit checks passed');\nNODE"
