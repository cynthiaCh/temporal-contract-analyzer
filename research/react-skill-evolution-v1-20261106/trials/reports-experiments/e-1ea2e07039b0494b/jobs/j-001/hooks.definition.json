{
  "description": "Reviewed study-local bounded controller; same executable for passive and active conditions",
  "hooks": {
    "PostModelRequest": [
      {
        "hooks": [
          {
            "command": "/usr/bin/python3 /controller.py",
            "timeout": 10,
            "type": "command"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "hooks": [
          {
            "command": "/usr/bin/python3 /controller.py",
            "timeout": 10,
            "type": "command"
          }
        ]
      }
    ],
    "PreModelRequest": [
      {
        "hooks": [
          {
            "command": "/usr/bin/python3 /controller.py",
            "timeout": 10,
            "type": "command"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "hooks": [
          {
            "command": "/usr/bin/python3 /controller.py",
            "timeout": 10,
            "type": "command"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "command": "/usr/bin/python3 /controller.py",
            "timeout": 10,
            "type": "command"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "command": "/usr/bin/python3 /controller.py",
            "timeout": 10,
            "type": "command"
          }
        ]
      }
    ]
  }
}
