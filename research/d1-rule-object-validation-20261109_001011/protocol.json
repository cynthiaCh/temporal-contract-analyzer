{
  "version": "single-source-rules-1",
  "scope": "D1 same-case development diagnostic only",
  "case": "query-paused-initial-fetch-10266-vanilla",
  "reflect": {
    "model": "gpt-5.6-terra",
    "effort": "medium",
    "cap": 12,
    "seconds": 600,
    "tools": false
  },
  "repair": {
    "model": "gpt-5.6-terra",
    "effort": "low",
    "cap": 24,
    "seconds": 600,
    "tools": "same as AUTO"
  },
  "maximum_sessions": 3,
  "maximum_requests": 60,
  "concurrency": 1,
  "stdout_bytes": 16777216,
  "schedule": [
    "D1-reflection",
    "D1-revalidation-1",
    "D1-revalidation-2"
  ],
  "retry": false,
  "stop_on": [
    "first infrastructure anomaly",
    "invalid candidate",
    "confirmed unsupported semantic policy/factual conflict",
    "input or measurement distortion"
  ],
  "text_origin": "program-derived numbering, fixed category headings and exact model bodies; no other prose added",
  "admission": "At least one supported target/overall improvement, no confirmed unsupported policy; report every regression, no both-pass requirement.",
  "no_test_or_next_reflection": true
}
