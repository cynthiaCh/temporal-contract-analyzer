    {
      "id": "R-task",
      "kind": "documented_requirement",
      "statement": "The target concerns a fresh online-mode query created and removed offline; preserve supported behavior.",
      "author": "execution_agent_source_review",
      "related": [],
      "anchors": [
        {
          "type": "lines",
          "file": "inputs/task.md",
          "start": 1,
          "end": 1,
          "quote": "Repair the transit stop lookup cache: a fresh online-mode query mounted and unmounted entirely offline later calls its signal-consuming query function with a live signal after reconnect. This occurs independently of refetchOnReconnect. Preserve supported query behavior, interfaces, dependencies and build/test configuration. Change product source only."
        }
      ]
    },
    {
      "id": "F-ownership",
      "kind": "source_fact",
      "statement": "The getter sets the shared query consumption record but returns the current attempt controller. These are different storage owners.",
      "author": "execution_agent_source_review",
      "related": [],
      "anchors": [
        {
          "type": "lines",
          "file": "inputs/original.js",
          "start": 9,
          "end": 9,
          "quote": " invoke(q,a){a.queued=false;if(!this.active(q,a))return;q.state.fetchStatus='fetching';q.consumed=false;const context={key:q.key,attempt:a.number};Object.defineProperty(context,'signal',{enumerable:true,get(){q.consumed=true;return a.controller.signal;}});let value;try{value=this.host.queryFn(context);}catch(e){value=Promise.reject(e);}Promise.resolve(value).then(value=>{if(!this.active(q,a))return;a.settled=true;q.state={...q.state,data:value,status:'success',fetchStatus:'idle'};this.project(q);},()=>{if(!this.active(q,a))return;if(!a.retryCancelled&&a.failures<(a.options.retry||0)){a.failures++;this.host.timers.schedule(()=>{if(!this.active(q,a))return;if(a.retryCancelled){a.settled=true;q.state={...q.state,status:'error',fetchStatus:'idle'};}else if(this.eligible(a))this.invoke(q,a);else q.state.fetchStatus='paused';this.project(q);},a.options.retryDelay||10);}else{a.settled=true;q.state={...q.state,status:'error',fetchStatus:'idle'};}this.project(q);});this.project(q);}"
        }
      ]
    },
    {
      "id": "F-boundary",
      "kind": "source_fact",
      "statement": "Last-observer removal reads the shared consumption record; cancellation and retry suppression take different branches.",
      "author": "execution_agent_source_review",
      "related": [],
      "anchors": [
        {
          "type": "lines",
          "file": "inputs/original.js",
          "start": 12,
          "end": 12,
          "quote": " unsubscribe(handle){const q=this.handles.get(handle);if(!q)return;this.handles.delete(handle);q.observers.delete(handle);if(q.observers.size===0){const a=q.attempt;if(a&&!a.settled){if(q.consumed)this.cancel(q,a);else a.retryCancelled=true;}}this.project(q);}"
        }
      ]
    },
    {
      "id": "F-events",
      "kind": "source_fact",
      "statement": "Cancellation settles the attempt, restores previous state and aborts its resource; active identity gates completion.",
      "author": "execution_agent_source_review",
      "related": [],
      "anchors": [
        {
          "type": "lines",
          "file": "inputs/original.js",
          "start": 7,
          "end": 10,
          "quote": " active(q,a){return q.attempt===a&&!a.settled;}\n cancel(q,a){if(a.settled)return;a.settled=true;q.state={...a.previous,fetchStatus:'idle'};a.controller.abort();this.project(q);}\n invoke(q,a){a.queued=false;if(!this.active(q,a))return;q.state.fetchStatus='fetching';q.consumed=false;const context={key:q.key,attempt:a.number};Object.defineProperty(context,'signal',{enumerable:true,get(){q.consumed=true;return a.controller.signal;}});let value;try{value=this.host.queryFn(context);}catch(e){value=Promise.reject(e);}Promise.resolve(value).then(value=>{if(!this.active(q,a))return;a.settled=true;q.state={...q.state,data:value,status:'success',fetchStatus:'idle'};this.project(q);},()=>{if(!this.active(q,a))return;if(!a.retryCancelled&&a.failures<(a.options.retry||0)){a.failures++;this.host.timers.schedule(()=>{if(!this.active(q,a))return;if(a.retryCancelled){a.settled=true;q.state={...q.state,status:'error',fetchStatus:'idle'};}else if(this.eligible(a))this.invoke(q,a);else q.state.fetchStatus='paused';this.project(q);},a.options.retryDelay||10);}else{a.settled=true;q.state={...q.state,status:'error',fetchStatus:'idle'};}this.project(q);});this.project(q);}\n resume(q){const a=q.attempt;if(a&&this.active(q,a)&&q.state.fetchStatus==='paused'&&this.eligible(a)&&!a.queued){a.queued=true;Promise.resolve().then(()=>{a.queued=false;if(!this.active(q,a))return;if(a.failures&&a.retryCancelled){a.settled=true;q.state={...q.state,status:'error',fetchStatus:'idle'};this.project(q);return;}this.invoke(q,a);});}}"
        }
      ]
    },
    {
      "id": "F-creation",
      "kind": "source_fact",
      "statement": "A new query record has a consumption flag; creating another attempt does not directly reset that query flag. Actual invocation resets it.",
      "author": "execution_agent_source_review",
      "related": [],
      "anchors": [
        {
          "type": "lines",
          "file": "inputs/original.js",
          "start": 9,
          "end": 11,
          "quote": " invoke(q,a){a.queued=false;if(!this.active(q,a))return;q.state.fetchStatus='fetching';q.consumed=false;const context={key:q.key,attempt:a.number};Object.defineProperty(context,'signal',{enumerable:true,get(){q.consumed=true;return a.controller.signal;}});let value;try{value=this.host.queryFn(context);}catch(e){value=Promise.reject(e);}Promise.resolve(value).then(value=>{if(!this.active(q,a))return;a.settled=true;q.state={...q.state,data:value,status:'success',fetchStatus:'idle'};this.project(q);},()=>{if(!this.active(q,a))return;if(!a.retryCancelled&&a.failures<(a.options.retry||0)){a.failures++;this.host.timers.schedule(()=>{if(!this.active(q,a))return;if(a.retryCancelled){a.settled=true;q.state={...q.state,status:'error',fetchStatus:'idle'};}else if(this.eligible(a))this.invoke(q,a);else q.state.fetchStatus='paused';this.project(q);},a.options.retryDelay||10);}else{a.settled=true;q.state={...q.state,status:'error',fetchStatus:'idle'};}this.project(q);});this.project(q);}\n resume(q){const a=q.attempt;if(a&&this.active(q,a)&&q.state.fetchStatus==='paused'&&this.eligible(a)&&!a.queued){a.queued=true;Promise.resolve().then(()=>{a.queued=false;if(!this.active(q,a))return;if(a.failures&&a.retryCancelled){a.settled=true;q.state={...q.state,status:'error',fetchStatus:'idle'};this.project(q);return;}this.invoke(q,a);});}}\n subscribe(key,options={}){let q=this.cache.get(key);if(!q){const data=options.initialData===undefined?null:options.initialData;q={key,state:{status:data===null?'pending':'success',fetchStatus:'idle',data},observers:new Set(),attempt:null,consumed:false};this.cache.set(key,q);}const handle=++this.serial;this.handles.set(handle,q);q.observers.add(handle);if(q.attempt&&!q.attempt.settled){q.attempt.retryCancelled=false;this.resume(q);}else{const a=new Attempt(++this.fetchSerial,q.state,options);q.attempt=a;if((options.networkMode||'online')!=='online'||this.connected)this.invoke(q,a);else q.state.fetchStatus='paused';}this.project(q);return handle;}"
        }
      ]
    },
    {
      "id": "R-background",
      "kind": "documented_requirement",
      "statement": "Unconsumed active shared work may finish after view departure; consumed work is abortable; canceled late fulfillment must not become new-attempt data.",
      "author": "execution_agent_source_review",
      "related": [],
      "anchors": [
        {
          "type": "lines",
          "file": "inputs/README.md",
          "start": 12,
          "end": 16,
          "quote": "Multiple observers share one fetch. Unconsumed active work can finish into cache\nafter its view departs; consumed work is physically abortable. Cancellation\nreverts previous query data/status and settles the originating attempt. Late\nfulfillment cannot become a new attempt's data. Unknown unsubscribe is inert.\nThe component owns observer scope; the cache remains outside individual views."
        }
      ]
    },
    {
      "id": "R-entry",
      "kind": "documented_requirement",
      "statement": "Initial entry and paused continuation differ in timing and eligibility; actual lazy reads record consumption.",
      "author": "execution_agent_source_review",
      "related": [],
      "anchors": [
        {
          "type": "lines",
          "file": "inputs/README.md",
          "start": 6,
          "end": 11,
          "quote": "fetchStatus (idle/fetching/paused), and data. queryFn receives a lazy signal\naccessor. Each actual access records consumption; each fetch owns its controller\nand completion. Completion is asynchronous; initial online entry is synchronous,\npaused continuation resumes on a Promise turn. First start uses network mode;\ncontinuation also needs focus. 'always' can run offline; 'offlineFirst' allows\nfirst offline entry but retry can pause. Retries use explicit scheduler handles."
        }
      ]
    },
    {
      "id": "I-preservation",
      "kind": "preservation_inference",
      "statement": "Task preservation plus current separate record/resource ownership gives no authority to replace shared consumption with attempt-local consumption merely because the controller is attempt-local.",
      "author": "execution_agent_source_review",
      "related": [
        "F-ownership",
        "F-boundary",
        "F-creation"
      ],
