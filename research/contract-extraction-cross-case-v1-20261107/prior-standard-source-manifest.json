      "report": "C1-presence-bootstrap.md",
      "citation_segments": [
        {
          "fact_id": "C1-S1",
          "path": "cases/C1/candidate/src/channel.js",
          "start_line": 8,
          "end_line": 20,
          "source_sha256": "b6e69590b253b577aed53078e2f6b09caf62599cf4286a72dd28f9edc5647736",
          "verbatim_excerpt": "export function createPresenceChannel(token, { decode = (value) => value } = {}) {\n  const target = new EventTarget();\n  const emit = (kind) => target.dispatchEvent(new PresenceEvent(`${token}:${kind}`));\n  return {\n    target,\n    decode,\n    connect(bootstrapMode) {\n      if (bootstrapMode === \"deferred\") queueMicrotask(() => emit(\"bootstrap\"));\n      else emit(\"bootstrap\");\n    },\n    emitUpdate() {\n      emit(\"update\");\n    },",
          "role": "original source, not historical patch"
        },
        {
          "fact_id": "C1-S2",
          "path": "cases/C1/candidate/src/subscription.js",
          "start_line": 3,
          "end_line": 11,
          "source_sha256": "ce862f1f8a3fe75044e4068261ae1753278562ac72c839e44a14d3976662a3a2",
          "verbatim_excerpt": "export function subscribeChannel(channel, bootstrapMode, receive) {\n  const listener = (event) => {\n    const decoded = channel.decode(event.detail);\n    if (decoded && typeof decoded.then === \"function\") decoded.then(receive);\n    else receive(decoded);\n  };\n  channel.connect(bootstrapMode);\n  channel.target.addEventListener(\"presence\", listener);\n  return () => channel.target.removeEventListener(\"presence\", listener);",
          "role": "original source, not historical patch"
        },
        {
          "fact_id": "C1-S3",
          "path": "cases/C1/candidate/src/presence-panel.js",
          "start_line": 4,
          "end_line": 14,
          "source_sha256": "c349d97040889ef6d14ab0121e0dda2b2d1e951b898a0a1f33ccc9785288c000",
          "verbatim_excerpt": "export function createPresencePanel(publish) {\n  let release = () => {};\n  return {\n    show(channel, bootstrapMode = \"synchronous\") {\n      release();\n      release = subscribeChannel(channel, bootstrapMode, publish);\n    },\n    close() {\n      release();\n      release = () => {};\n    },",
          "role": "original source, not historical patch"
        },
        {
          "fact_id": "C1-S4",
          "path": "cases/C1/candidate/src/presence-panel.js",
          "start_line": 18,
          "end_line": 26,
          "source_sha256": "c349d97040889ef6d14ab0121e0dda2b2d1e951b898a0a1f33ccc9785288c000",
          "verbatim_excerpt": "export async function renderPresence(token, bootstrapMode) {\n  const events = [];\n  const panel = createPresencePanel((value) => events.push(value));\n  const channel = createPresenceChannel(token);\n  panel.show(channel, bootstrapMode);\n  await Promise.resolve();\n  channel.emitUpdate();\n  panel.close();\n  return { events };",
          "role": "original source, not historical patch"
        },
        {
          "fact_id": "C1-S5",
          "path": "cases/C1/candidate/src/metrics-consumer.js",
          "start_line": 3,
          "end_line": 5,
          "source_sha256": "73445d7fb5ede97450b4f339370c1f0987394808ce312bb0407694575b380213",
          "verbatim_excerpt": "export function collectMetrics(token) {\n  // Metrics deliberately attach after the synchronous bootstrap and count deltas only.\n  return observeChannel({ token, bootstrapMode: \"synchronous\" });",
          "role": "original source, not historical patch"
        },
        {
          "fact_id": "C1-S5",
          "path": "cases/C1/candidate/src/channel.js",
          "start_line": 24,
          "end_line": 31,
          "source_sha256": "b6e69590b253b577aed53078e2f6b09caf62599cf4286a72dd28f9edc5647736",
          "verbatim_excerpt": "export async function observeChannel({ token, bootstrapMode }) {\n  const events = [];\n  const channel = createPresenceChannel(token);\n  channel.connect(bootstrapMode);\n  channel.target.addEventListener(\"presence\", (event) => events.push(event.detail));\n  await Promise.resolve();\n  channel.emitUpdate();\n  return { events };",
          "role": "original source, not historical patch"
        },
        {
          "fact_id": "C1-S6",
          "path": "cases/C1/candidate/src/workspace-navigation.js",
          "start_line": 3,
          "end_line": 10,
          "source_sha256": "3745d2d03240263eea523df10e5bf4d6b7c52aa20496406b1959035b2fe2040d",
          "verbatim_excerpt": "// Presence publication can synchronously select a different room or hide the\n// panel (for example, a room chooser reacting to an empty bootstrap snapshot).\n// Reusing a transport object on a later visit is supported by the workspace.\nexport function createWorkspaceNavigation(renderState) {\n  const panel = createPresencePanel((value) => renderState(value, navigation));\n  const navigation = {\n    select(channel, mode = \"synchronous\") { panel.show(channel, mode); },\n    hide() { panel.close(); },",
          "role": "original source, not historical patch"
        },
        {
          "fact_id": "C1-S6",
          "path": "cases/C1/candidate/src/render-workspace.js",
          "start_line": 4,
          "end_line": 9,
          "source_sha256": "0d1412acc6eeda2ea6fa3d1b50314be93fa28b7e74e124faec0354129aa19035",
          "verbatim_excerpt": "export async function render({ token, bootstrapMode }) {\n  const [presence, metrics] = await Promise.all([\n    renderPresence(token, bootstrapMode),\n    collectMetrics(token),\n  ]);\n  return { presence, metrics };",
          "role": "original source, not historical patch"
        }
      ],
