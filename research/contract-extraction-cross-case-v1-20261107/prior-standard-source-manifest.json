      "citation_segments": [
        {
          "fact_id": "C2-S1",
          "path": "cases/C2/candidate/src/editor.js",
          "start_line": 3,
          "end_line": 20,
          "source_sha256": "bb34b4ef38060d7b9b5bd7b83c82f757f7f6a49426d6d574689dd201930e7363",
          "verbatim_excerpt": "export function createDraftEditor({ store, timers, renderDocument, renderStatus }) {\n  let current = null;\n  function close() {\n    const leaving = current;\n    current = null;\n    if (leaving) leaving.stop();\n    renderDocument(null);\n  }\n  return {\n    open(id) {\n      close();\n      current = { id, text: store.read(id), visit: {}, stop: attachSaveStatus(store, id, renderStatus) };\n      renderDocument({ id, text: current.text });\n    },\n    edit(text) {\n      if (!current) return;\n      current.text = text;\n      store.write(current.id, text);",
          "role": "original source, not historical patch"
        },
        {
          "fact_id": "C2-S2",
          "path": "cases/C2/candidate/src/draft-store.js",
          "start_line": 10,
