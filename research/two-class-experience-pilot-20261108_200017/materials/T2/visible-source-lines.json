    ],
    [
      45,
      "        self.receipts.append(receipt)"
    ],
    [
      46,
      "        return vars(receipt).copy()"
    ],
    [
      47,
      ""
    ],
    [
      48,
      "    def list(self):"
    ],
    [
      49,
      "        return [vars(receipt).copy() for receipt in self.receipts]"
