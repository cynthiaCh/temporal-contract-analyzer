{
  "hooks": {
    "PreModelRequest": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/usr/bin/python3 -B /request_guard.py",
            "timeout": 10
          }
        ]
      }
    ],
    "PostModelRequest": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/usr/bin/python3 -B /request_guard.py",
            "timeout": 10
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/usr/bin/python3 -B /request_guard.py",
            "timeout": 10
          }
        ]
      }
    ],
    "PermissionRequest": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/usr/bin/python3 -B /request_guard.py",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
