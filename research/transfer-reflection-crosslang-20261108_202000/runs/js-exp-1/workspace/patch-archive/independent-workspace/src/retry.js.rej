--- src/retry.js
+++ src/retry.js
@@ -5,6 +5,9 @@
 export function retryTransfer(state) {
   const visit = state.current;
   if (!visit || !visit.handle || state.disposed) return null;
   const previous = visit.handle;
   previous.cancel();
+  // Cancellation callbacks are synchronous and may navigate, hide, or issue a
+  // nested retry. Do not let this superseded command create another attempt.
+  if (state.current !== visit || state.disposed || visit.handle !== previous) return null;
   const handle = enqueueTransfer(state, visit, "retry");
