{
  "name": "temporal-contract-analyzer",
  "displayName": "TempoEvo: Temporal Contract Analyzer",
  "description": "Temporal source review for Vue, JS/TS and Python: archived scans, evidence navigation and review hints.",
  "version": "0.2.0",
  "publisher": "temporal-contract-tools",
  "private": true,
  "license": "UNLICENSED",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Linters",
    "Other"
  ],
  "keywords": [
    "vue",
    "temporal",
    "async",
    "review"
  ],
  "main": "./src/extension.js",
  "extensionKind": [
    "workspace"
  ],
  "activationEvents": [
    "onLanguage:vue",
    "onLanguage:javascript",
    "onLanguage:javascriptreact",
    "onLanguage:typescript",
    "onLanguage:typescriptreact",
    "onLanguage:python"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": false,
      "description": "The analyzer starts local Python and Node parser processes; trust the workspace first."
    },
    "virtualWorkspaces": {
      "supported": false,
      "description": "Requires the filesystem of a local or remote extension host."
    }
  },
  "contributes": {
    "commands": [
      {
        "command": "temporalContracts.scanFile",
        "title": "Scan current file",
        "category": "TempoEvo",
        "icon": "$(inspect)"
      },
      {
        "command": "temporalContracts.scanFolder",
        "title": "Scan folder…",
        "category": "TempoEvo",
        "icon": "$(folder-opened)"
      },
      {
        "command": "temporalContracts.showReport",
        "title": "View latest full report",
        "category": "TempoEvo",
        "icon": "$(preview)"
      },
      {
        "command": "temporalContracts.openArchive",
        "title": "Open shared report archive",
        "category": "TempoEvo",
        "icon": "$(archive)"
      },
      {
        "command": "temporalContracts.copyReportId",
        "title": "Copy latest report ID",
        "category": "TempoEvo"
      },
      {
        "command": "temporalContracts.clear",
        "title": "Clear analysis results",
        "category": "TempoEvo",
        "icon": "$(clear-all)"
      },
      {
        "command": "temporalContracts.showOutput",
        "title": "View runtime log",
        "category": "TempoEvo"
      }
    ],
    "views": {
      "explorer": [
        {
          "id": "temporalContracts.findings",
          "name": "TempoEvo"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "temporalContracts.findings",
        "contents": "Find temporal clues in the current code; click evidence to navigate to source.\n[Scan current file](command:temporalContracts.scanFile)\n[Scan folder](command:temporalContracts.scanFolder)\nHints require human review; no match does not establish safety."
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "temporalContracts.scanFile",
          "when": "view == temporalContracts.findings",
          "group": "navigation@1"
        },
        {
          "command": "temporalContracts.scanFolder",
          "when": "view == temporalContracts.findings",
          "group": "navigation@2"
        },
        {
          "command": "temporalContracts.showReport",
          "when": "view == temporalContracts.findings",
          "group": "navigation@3"
        },
        {
          "command": "temporalContracts.openArchive",
          "when": "view == temporalContracts.findings",
          "group": "navigation@4"
        },
        {
          "command": "temporalContracts.clear",
          "when": "view == temporalContracts.findings",
          "group": "navigation@4"
        }
      ],
      "editor/title": [
        {
          "command": "temporalContracts.scanFile",
          "when": "resourceScheme == file && resourceExtname =~ /\\.(vue|js|jsx|ts|tsx|mjs|cjs|py)$/",
          "group": "navigation@20"
        }
      ],
      "explorer/context": [
        {
          "command": "temporalContracts.scanFolder",
          "when": "explorerResourceIsFolder && resourceScheme == file",
          "group": "temporalContracts"
        }
      ]
    },
    "configuration": {
      "title": "TempoEvo",
      "properties": {
        "temporalContracts.scanOnSave": {
          "type": "boolean",
          "default": true,
          "description": "Automatically scan supported source files on save. Clear stale locations immediately after edits.",
          "scope": "resource"
        },
        "temporalContracts.pythonPath": {
          "type": "string",
          "default": "",
          "description": "Path to a Python 3.9+ executable; leave empty for automatic discovery. Do not enter shell commands or arguments.",
          "scope": "machine"
        },
        "temporalContracts.archiveEnabled": {
          "type": "boolean",
          "default": true,
          "description": "Save a separate report and actual source snapshot for each scan for later research review.",
          "scope": "resource"
        },
        "temporalContracts.reportStore": {
          "type": "string",
          "default": "",
          "description": "Shared report archive directory. Leave empty to use the same global configuration as the standalone CLI and Codex; the archive must be outside the candidate project.",
          "scope": "machine"
        },
        "temporalContracts.timeoutSeconds": {
          "type": "number",
          "default": 90,
          "minimum": 10,
          "maximum": 300,
          "description": "Maximum runtime for a single analysis.",
          "scope": "window"
        }
      }
    }
  },
  "scripts": {
    "stage": "node scripts/stage-runtime.cjs",
    "test": "node --test test/runner.test.cjs",
    "test:host": "node test/run-host.cjs",
    "test:browser": "node test/report-browser.cjs",
    "package": "npm run stage && vsce package --no-dependencies --allow-missing-repository --skip-license --out ../dist/temporal-contract-analyzer-0.2.0.vsix"
  },
  "devDependencies": {
    "@vscode/test-electron": "2.4.1",
    "@vscode/vsce": "2.32.0",
    "playwright": "1.51.1"
  },
  "overrides": {
    "cheerio": "1.0.0"
  }
}
