{
  "name": "temporal-contract-analyzer",
  "displayName": "Temporal Contracts",
  "description": "Vue、JS/TS 和 Python 的时序源码审查：保存扫描、证据定位与待核查提示。",
  "version": "0.2.0",
  "publisher": "temporal-contract-tools",
  "private": true,
  "license": "UNLICENSED",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Linters",
    "Other"
  ],
  "keywords": [
    "vue",
    "temporal",
    "async",
    "review"
  ],
  "main": "./src/extension.js",
  "extensionKind": [
    "workspace"
  ],
  "activationEvents": [
    "onLanguage:vue",
    "onLanguage:javascript",
    "onLanguage:javascriptreact",
    "onLanguage:typescript",
    "onLanguage:typescriptreact",
    "onLanguage:python"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": false,
      "description": "分析器需要启动本地 Python 和 Node 解析进程，请先信任工作区。"
    },
    "virtualWorkspaces": {
      "supported": false,
      "description": "需要本地或远程扩展宿主的文件系统。"
    }
  },
  "contributes": {
    "commands": [
      {
        "command": "temporalContracts.scanFile",
        "title": "扫描当前文件",
        "category": "Temporal Contracts",
        "icon": "$(inspect)"
      },
      {
        "command": "temporalContracts.scanFolder",
        "title": "扫描目录…",
        "category": "Temporal Contracts",
        "icon": "$(folder-opened)"
      },
      {
        "command": "temporalContracts.showReport",
        "title": "查看最近的完整报告",
        "category": "Temporal Contracts",
        "icon": "$(preview)"
      },
      {
        "command": "temporalContracts.openArchive",
        "title": "打开统一报告库",
        "category": "Temporal Contracts",
        "icon": "$(archive)"
      },
      {
        "command": "temporalContracts.copyReportId",
        "title": "复制最近报告 ID",
        "category": "Temporal Contracts"
      },
      {
        "command": "temporalContracts.clear",
        "title": "清除分析结果",
        "category": "Temporal Contracts",
        "icon": "$(clear-all)"
      },
      {
        "command": "temporalContracts.showOutput",
        "title": "查看运行日志",
        "category": "Temporal Contracts"
      }
    ],
    "views": {
      "explorer": [
        {
          "id": "temporalContracts.findings",
          "name": "Temporal Contracts"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "temporalContracts.findings",
        "contents": "从当前代码中查找时序线索，点击证据可定位源码。\n[扫描当前文件](command:temporalContracts.scanFile)\n[扫描目录](command:temporalContracts.scanFolder)\n提示需要人工核查；没有命中不代表安全。"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "temporalContracts.scanFile",
          "when": "view == temporalContracts.findings",
          "group": "navigation@1"
        },
        {
          "command": "temporalContracts.scanFolder",
          "when": "view == temporalContracts.findings",
          "group": "navigation@2"
        },
        {
          "command": "temporalContracts.showReport",
          "when": "view == temporalContracts.findings",
          "group": "navigation@3"
        },
        {
          "command": "temporalContracts.openArchive",
          "when": "view == temporalContracts.findings",
          "group": "navigation@4"
        },
        {
          "command": "temporalContracts.clear",
          "when": "view == temporalContracts.findings",
          "group": "navigation@4"
        }
      ],
      "editor/title": [
        {
          "command": "temporalContracts.scanFile",
          "when": "resourceScheme == file && resourceExtname =~ /\\.(vue|js|jsx|ts|tsx|mjs|cjs|py)$/",
          "group": "navigation@20"
        }
      ],
      "explorer/context": [
        {
          "command": "temporalContracts.scanFolder",
          "when": "explorerResourceIsFolder && resourceScheme == file",
          "group": "temporalContracts"
        }
      ]
    },
    "configuration": {
      "title": "Temporal Contracts",
      "properties": {
        "temporalContracts.scanOnSave": {
          "type": "boolean",
          "default": true,
          "description": "保存支持的源码文件后自动扫描该文件。编辑后立即清除旧定位。",
          "scope": "resource"
        },
        "temporalContracts.pythonPath": {
          "type": "string",
          "default": "",
          "description": "Python 3.9+ 可执行文件路径；留空自动查找。不要填写 shell 命令或参数。",
          "scope": "machine"
        },
        "temporalContracts.archiveEnabled": {
          "type": "boolean",
          "default": true,
          "description": "每次扫描保存独立报告及实际源码快照，供研究回看。",
          "scope": "resource"
        },
        "temporalContracts.reportStore": {
          "type": "string",
          "default": "",
          "description": "统一报告库目录。留空与独立 CLI、Codex 使用同一全局配置；报告库必须位于候选工程之外。",
          "scope": "machine"
        },
        "temporalContracts.timeoutSeconds": {
          "type": "number",
          "default": 90,
          "minimum": 10,
          "maximum": 300,
          "description": "单次分析的最长运行时间。",
          "scope": "window"
        }
      }
    }
  },
  "scripts": {
    "stage": "node scripts/stage-runtime.cjs",
    "test": "node --test test/runner.test.cjs",
    "test:host": "node test/run-host.cjs",
    "test:browser": "node test/report-browser.cjs",
    "package": "npm run stage && vsce package --no-dependencies --allow-missing-repository --skip-license --out ../dist/temporal-contract-analyzer-0.2.0.vsix"
  },
  "devDependencies": {
    "@vscode/test-electron": "2.4.1",
    "@vscode/vsce": "2.32.0",
    "playwright": "1.51.1"
  },
  "overrides": {
    "cheerio": "1.0.0"
  }
}
