{
  "name": "temporal-contract-analyzer",
  "displayName": "TempoEvo: My Experiences",
  "description": "Browse, write and manage your own local experience library. Save directly without approval.",
  "version": "0.3.1",
  "publisher": "temporal-contract-tools",
  "private": true,
  "license": "UNLICENSED",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other"
  ],
  "keywords": [
    "experience",
    "knowledge",
    "memory"
  ],
  "main": "./src/experience-extension.js",
  "extensionKind": [
    "workspace"
  ],
  "activationEvents": [
    "onView:temporalContracts.experiences"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": false,
      "description": "The analyzer starts local Python and Node parser processes; trust the workspace first."
    },
    "virtualWorkspaces": {
      "supported": false,
      "description": "Requires the filesystem of a local or remote extension host."
    }
  },
  "contributes": {
    "commands": [
      {
        "command": "temporalContracts.openExperience",
        "title": "Open my experiences",
        "category": "TempoEvo",
        "icon": "$(book)"
      },
      {
        "command": "temporalContracts.chooseLibrary",
        "title": "Choose experience library",
        "category": "TempoEvo",
        "icon": "$(folder-opened)"
      }
    ],
    "views": {
      "explorer": [
        {
          "id": "temporalContracts.experiences",
          "name": "My experiences"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "temporalContracts.experiences",
        "contents": "Write and manage your own experiences. Save directly; no review required.\n[Choose library](command:temporalContracts.chooseLibrary)\n[Open editor](command:temporalContracts.openExperience)"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "temporalContracts.openExperience",
          "when": "view == temporalContracts.experiences",
          "group": "navigation@1"
        },
        {
          "command": "temporalContracts.chooseLibrary",
          "when": "view == temporalContracts.experiences",
          "group": "navigation@2"
        }
      ]
    },
    "configuration": {
      "title": "TempoEvo",
      "properties": {
        "temporalContracts.experienceStore": {
          "type": "string",
          "default": "",
          "description": "Local categorized experience library directory.",
          "scope": "machine"
        },
        "temporalContracts.pythonPath": {
          "type": "string",
          "default": "",
          "description": "Path to a Python 3.9+ executable; leave empty for automatic discovery. Do not enter shell commands or arguments.",
          "scope": "machine"
        }
      }
    }
  },
  "scripts": {
    "stage": "node scripts/stage-runtime.cjs",
    "test": "node test/owner-runner.cjs",
    "test:host": "node test/run-host.cjs",
    "test:browser": "node test/report-browser.cjs",
    "package": "npm run stage && vsce package --no-dependencies --allow-missing-repository --skip-license --out ../dist/temporal-contract-analyzer-0.3.1.vsix",
    "test:experiences": "node test/experiences-browser.cjs",
    "test:legacy": "node --test test/runner.test.cjs"
  },
  "devDependencies": {
    "@vscode/test-electron": "2.4.1",
    "@vscode/vsce": "2.32.0",
    "playwright": "1.51.1"
  },
  "overrides": {
    "cheerio": "1.0.0"
  }
}
