{
  "schema_version": "tempoevo-model-profiles-v1",
  "default_profile": "custom-responses",
  "retry_policy": {"max_retries": 2, "backoff_seconds": 2},
  "profiles": {
    "custom-responses": {
      "model": "YOUR_PROVIDER_MODEL_ID",
      "reasoning_effort": null,
      "service_tier": null,
      "provider": {
        "name": "Compatible provider",
        "wire_api": "responses",
        "base_url": "https://provider.example/v1",
        "requires_openai_auth": false,
        "env_key": "TEMPOEVO_PROVIDER_API_KEY"
      }
    }
  }
}
